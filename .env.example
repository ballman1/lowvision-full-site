# Supabase — create a project at https://supabase.com
# Copy these values from your project's Settings > API page
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Setup checklist:
# 1. Enable "Email" provider under Authentication > Providers
# 2. Enable "Google" provider and add your OAuth client ID + secret
#    (create at https://console.cloud.google.com/apis/credentials)
# 3. Add https://your-site.com/auth/callback to Authentication > URL Configuration > Redirect URLs

# AI assistant (server/chat) — OpenAI GPT-6 Luna. Server-side only: never prefix with VITE_.
# Cloudflare Workers: npx wrangler secret put OPENAI_API_KEY
#   (or Workers & Pages → lowvision-full-site → Settings → Variables and Secrets)
# Cloudflare Pages / Netlify: add it in that project's environment variable settings.
# For local `wrangler dev`, put it in a .dev.vars file (git-ignored) instead.
OPENAI_API_KEY=your-openai-api-key
# Optional overrides (defaults are set in wrangler.jsonc for Workers):
# CHAT_MODEL=gpt-6-luna
# CHAT_EFFORT=medium   # low | medium | high

# Node server (Railway and similar hosts: `npm run build` then `npm start`)
# PORT is set automatically by Railway.
# CANONICAL_HOST=lowvisionnavigator.org   # optional: redirect www. and *.up.railway.app here
