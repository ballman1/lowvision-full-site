# Supabase — create a project at https://supabase.com
# Copy these values from your project's Settings > API page
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Setup checklist:
# 1. Enable "Email" provider under Authentication > Providers
# 2. Enable "Google" provider and add your OAuth client ID + secret
#    (create at https://console.cloud.google.com/apis/credentials)
# 3. Add https://your-site.com/auth/callback to Authentication > URL Configuration > Redirect URLs
